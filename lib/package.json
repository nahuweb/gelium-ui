{
  "name": "gelium-ui",
  "version": "0.6.7",
  "description": "Server-rendered UI components: Go + HTMX + Tailwind. HTML-first, 0-JS contract, themes by class. Components and styles, not a framework.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "htmx.org": ">=4.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "htmx.org": {
      "optional": true
    }
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.46.0",
    "@tabler/icons": "^3.46.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "styles",
    "themes",
    "templates",
    "js",
    "dist",
    "skills",
    "scripts",
    "references",
    "AGENTS.md",
    "SKILL.md",
    "SKILLS.md",
    "llms.txt",
    "llms-ux.txt",
    "install-agents.sh",
    "README.md"
  ],
  "exports": {
    ".": "./dist/gelium.css",
    "./styles/*": "./styles/*",
    "./styles/index.css": "./styles/index.css",
    "./themes/*": "./themes/*",
    "./templates/*": "./templates/*",
    "./js/*": "./js/*",
    "./js/gelium.js": "./js/gelium.js",
    "./dist/*": "./dist/*",
    "./dist/gelium.css": "./dist/gelium.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "ui",
    "components",
    "htmx",
    "tailwind",
    "css",
    "server-rendered",
    "design-system",
    "gelium"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptonahue/gelium-ui.git",
    "directory": "lib"
  },
  "homepage": "https://github.com/cryptonahue/gelium-ui#readme",
  "bugs": {
    "url": "https://github.com/cryptonahue/gelium-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
